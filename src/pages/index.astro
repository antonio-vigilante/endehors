---
import Sito from '../layouts/Sito.astro';
import VoceCatalogo from '../components/VoceCatalogo.astro';
import { getLibri } from '../lib/libri';

const libri = await getLibri();
---

<Sito>
  <div class="contenitore">
    <section class="presentazione">
      <p>Officina di controeditoria a cura di Antonio Vigilante</p>
    </section>

    <ol class="catalogo">
      {libri.map((l) => <VoceCatalogo libro={l} />)}
    </ol>
  </div>
</Sito>
